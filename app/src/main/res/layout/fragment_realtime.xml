<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <!-- ============ 聚焦模式顶部时间卡 ============
         ⭐ 双击任一卡片后：只显示该卡 + 本时间卡，卡片在时间卡下方居中。
         参考首页的时间卡片样式（无标题、居中、主题蓝）。
         默认 gone，由 RealtimeFragment.applyCardVisibility() 控制显隐。 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_focus_clock"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <!-- ⭐ 聚焦任意卡时：时间左侧=前胎压，右侧=后胎压（用户要求） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tv_clock_tpms_front"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="前轮 1.34Bar" />

                <TextView
                    android:id="@+id/tv_focus_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.04"
                    android:textColor="@color/primary"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    tools:text="20:50" />

                <TextView
                    android:id="@+id/tv_clock_tpms_rear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="后轮 1.82Bar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

<!-- ============ GPS 速度曲线 ============ -->
        <!-- ⚠️⚠️⚠️ **结构与功率卡逐字节同构**（照抄，不是自己调出来的）。
             之前反复 8 轮的根源：一直在「结构不同」的速度卡上调参数
             （padding / minHeight / translationY / 覆盖层……），
             而正确做法是**直接抄功率卡的布局**，只改 id 和文案。

             与功率卡的唯一差异：**标题行是三列**（标题 | 时间 | Max）
             而功率卡是两列（标题 | Max/Min）。
             为此把标题行高度锁死 20dp + Max 用 center_vertical，
             保证三列的高度与功率卡两列**完全等效**（实测均 91px 内容区）。 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:id="@+id/card_speed">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- 标题行：三列并排，高度锁 20dp 使其与功率卡两列等效 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- ⭐ 标题与 Max **各占一半权重**，时间 wrap_content 夹在中间。
                         这样时间是「左半 + 右半」的分界处 = 整卡真正的水平居中。
                         ⚠️ 若给时间 weight=1，它居中的只是「标题右 → 卡片右」那段，
                         视觉上必然偏右（Max 为INVISIBLE 时尤其明显）。 -->
                    <TextView
                        android:id="@+id/tv_speed_title"
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/chart_speed" />

                    <TextView
                        android:id="@+id/tv_realtime_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:letterSpacing="0.04"
                        android:textColor="@color/primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="23:57" />

                    <!--⭐ 样式与其他三张卡的 stat（tv_*_stat）完全一致：
                         style=MetricValue + textSize 12sp，风格统一。
                         ⚠️ 之前用 20sp，父容器只有 20dp 高，行高超出被裁
                         （用户反馈"Max 25 显示不全"），12sp 放得下且不撑高标题行、
                         不影响「速度」二字位置。
                         ⚠️ 颜色/字号完全交给 style，不覆盖 textColor ——
                         其他三张卡的 stat 用的是 MetricValue 默认的 text_primary，
                         之前单独给 primary(主色) 是"强调最大值"的自作主张，反而不统一。
                         translationZ 只提升绘制层级，不影响测量，保留防遮挡。 -->
                    <TextView
                        android:id="@+id/tv_gps_max"
                        style="@style/MetricValue"
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_weight="1"
                        android:layout_marginTop="0dp"
                        android:gravity="center_vertical|end"
                        android:translationZ="8dp"
                        android:textSize="12sp"
                        tools:text="Max 25" />
                </LinearLayout>

                <!-- 曲线区：与功率卡完全一致（110dp 固定） -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="6dp">

                    <io.github.supit.rideassist.ui.widget.TrendChartView
                        android:id="@+id/chart_speed"
                        android:layout_width="match_parent"
                        android:visibility="invisible"
                        android:layout_height="match_parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        style="@style/ChartWatermark">

                        <TextView
                            android:id="@+id/tv_speed_now"
                            style="@style/ChartWatermarkValue"
                            android:textColor="@color/primary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="32" />

                        <TextView
                            android:id="@+id/tv_speed_now_unit"
                            style="@style/ChartWatermarkUnit"
                            app:layout_constraintBottom_toBottomOf="@id/tv_speed_now"
                            app:layout_constraintStart_toEndOf="@id/tv_speed_now"
                            android:text="@string/unit_kmh"
                            android:textColor="@color/primary"
                            tools:text="km/h" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

                <!-- ============ GPS 信号丢失提示卡 ============
         ⭐ 需求4：速度卡聚焦时，若 GPS 丢失，在速度卡**下面**显示本卡，
         内容为「GPS 信号丢失 + 已丢失时长」。
         默认 gone，由 RealtimeFragment.renderGpsLostCard() 控制显隐。
         ⚠️ 只在聚焦速度卡时显示 —— 普通布局下速度卡高度会跳动。 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_gps_lost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gps_lost_title"
                    android:textColor="@color/state_failed"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_gps_lost_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/state_failed"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="3 分 02 秒" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 胎压卡（聚焦速度卡时显示，用户要求） ============
             格式参照首页：前/后轮 胎压+单位，不显示更新时间，越界标红。
             ⚠️ 不加 clickable —— 触摸要穿透到内容容器（左右滑切卡/双击切曲线）。 -->


        <!-- ============ 功率曲线 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:layout_marginTop="6dp"
            android:id="@+id/card_power">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/chart_power" />

                    <TextView
                        android:id="@+id/tv_power_stat"
                        style="@style/MetricValue"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ⭐ 当前值大字居中悬浮在曲线之上，不额外占用卡片高度 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="6dp">

                    <io.github.supit.rideassist.ui.widget.TrendChartView
                        android:id="@+id/chart_power"
                        android:layout_width="match_parent"
                        android:visibility="invisible"
                        android:layout_height="match_parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        style="@style/ChartWatermark">

                        <TextView
                            android:id="@+id/tv_power_now"
                            style="@style/ChartWatermarkValue"
                            android:textColor="@color/chart_voltage"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="-612" />

                        <TextView
                            android:id="@+id/tv_power_now_unit"
                            style="@style/ChartWatermarkUnit"
                            app:layout_constraintBottom_toBottomOf="@id/tv_power_now"
                            app:layout_constraintStart_toEndOf="@id/tv_power_now"
                            android:text="@string/unit_watt"
                            android:textColor="@color/chart_voltage"
                            tools:text="W" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 电流曲线 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:layout_marginTop="6dp"
            android:id="@+id/card_current">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/chart_current" />

                    <TextView
                        android:id="@+id/tv_current_stat"
                        style="@style/MetricValue"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ⭐ 当前值大字居中悬浮在曲线之上 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="6dp">

                    <io.github.supit.rideassist.ui.widget.TrendChartView
                        android:id="@+id/chart_current"
                        android:layout_width="match_parent"
                        android:visibility="invisible"
                        android:layout_height="match_parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        style="@style/ChartWatermark">

                        <TextView
                            android:id="@+id/tv_current_now"
                            style="@style/ChartWatermarkValue"
                            android:textColor="@color/chart_current"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="-9" />

                        <TextView
                            android:id="@+id/tv_current_now_unit"
                            style="@style/ChartWatermarkUnit"
                            app:layout_constraintBottom_toBottomOf="@id/tv_current_now"
                            app:layout_constraintStart_toEndOf="@id/tv_current_now"
                            android:text="@string/unit_ampere"
                            android:textColor="@color/chart_current"
                            tools:text="A" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 压差曲线 ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:layout_marginTop="6dp"
            android:id="@+id/card_diff">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/chart_diff" />

                    <TextView
                        android:id="@+id/tv_diff_stat"
                        style="@style/MetricValue"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ⭐ 当前值大字居中悬浮在曲线之上 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="6dp">

                    <io.github.supit.rideassist.ui.widget.TrendChartView
                        android:id="@+id/chart_diff"
                        android:layout_width="match_parent"
                        android:visibility="invisible"
                        android:layout_height="match_parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        style="@style/ChartWatermark">

                        <TextView
                            android:id="@+id/tv_diff_now"
                            style="@style/ChartWatermarkValue"
                            android:textColor="@color/primary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="7" />

                        <TextView
                            android:id="@+id/tv_diff_now_unit"
                            style="@style/ChartWatermarkUnit"
                            app:layout_constraintBottom_toBottomOf="@id/tv_diff_now"
                            app:layout_constraintStart_toEndOf="@id/tv_diff_now"
                            android:text="@string/unit_mv"
                            android:textColor="@color/primary"
                            tools:text="mV" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ XX 最大值记录卡（四张卡通用） ============ -->
        <!-- ⭐ **泛化设计**：速度/功率/电流/压差 四张卡共用这一张记录卡。
             放在 GPS 卡之后，各卡的显隐由 [renderPeakRecordCard] 控制：
             只有**聚焦某张卡**时才显示对应的那一条记录。
             速度/功率/电流只有 1 行（最大XX @ 时间）；
             压差多 3 行（工作电流 / 最高单体 / 最低单体）。 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_peak_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <!-- 第一行：最大XX @ 时间（所有卡都有） -->
                <TextView
                    android:id="@+id/tv_peak_record_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="最大压差 35mV @ 12:34" />

                <!-- 以下 3 行**仅压差卡**使用，其余卡 GONE -->

                <TextView
                    android:id="@+id/tv_peak_record_detail1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="工作电流：89 A" />

                <TextView
                    android:id="@+id/tv_peak_record_detail2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="最高电压：单体 12  3.400 V" />

                <TextView
                    android:id="@+id/tv_peak_record_detail3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="最低电压：单体 08  3.210 V" />

                <!-- ⭐ 第 4 行：偏离其余电芯均值最多的那颗
                     与「最高/最低」是两个极端不同，这里回答的是
                     「哪一颗最不像一伙的」，用于一致性诊断。 -->
                <TextView
                    android:id="@+id/tv_peak_record_detail4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/state_discharging"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="偏离最多：单体 08（偏低85.0mV）" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
