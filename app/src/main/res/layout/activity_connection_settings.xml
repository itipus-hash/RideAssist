<?xml version="1.0" encoding="utf-8"?>
<!--
  ⭐ 独立的「连接设置」页（用户 2026-11-09 要求）：
  从首页连接状态卡的齿轮进来，只放连接相关设置，**不与胎压设置页共享**。

  目前两项：「连接BMS后自动跳转」与「实时界面曲线显示」（2026-11-11 改名）。按用户要求：
  - 每项一行搞定：左边文字，右边直接是下拉框；
  - 不写任何说明 / 提示文案；
  - 「连接BMS后自动跳转」选项：不跳转 / 实时·页面 / 数据·页面 / 导航·页面。

  ⭐ 2026-11-11 对齐口径（用户：「备选和弹出来的菜单，包括下面填的数值，都要居中」）：
  - 左侧标题一律**左对齐**；
  - 右侧所有控件里的文字一律**居中**：下拉框选中项、下拉弹出菜单每一项、
    数字输入框里的数值；
  - 下拉框的居中靠代码换 item 布局实现（`bindCenteredSpinner`），
    XML 的 `android:gravity` 对 Spinner 条目无效，所以这里**不写 entries**。

  2026-11-10 新增第三、四项：两项**记录阈值**（数字输入，右侧输入框）：
  - 最大压差记录阈值（mV），默认 50；
  - 极速记录阈值（Km/h），默认 50。
  同日又加第五、六项（电流 / 功率）：
  - 电流记录阈值（A），默认 50；
  - 功率记录阈值（W），默认 1000。
  留空或填非法值 → 失焦 / 关闭页面时回填各自默认值（见 RecordThreshold）。

  同日再加第七项（下拉框）：
  - 实时卡片胎压显示：始终显示 / 始终不显示 / 胎压异常时显示，默认「始终显示」。
  这一项**不依赖保护板**，所以首页连接卡的齿轮未连接时也会显示。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/connection_settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:contentPadding="16dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 第一项：连接BMS后自动跳转 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_connect_jump_title"
                            android:textSize="14sp" />

                        <!-- ⚠️ 不写 android:entries：条目改由代码套「居中」适配器
                             （见 ConnectionSettingsActivity.bindCenteredSpinner），
                             避免 XML 与代码两处维护同一份标签。 -->
                        <Spinner
                            android:id="@+id/spinner_connect_jump_tab"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="112dp"
                            android:dropDownWidth="190dp"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>

                    <!-- 第二项（2026-11-09）：进入实时页时曲线是否默认显示。
                         风格与第一项完全一致：一行文字 + 右侧下拉，无任何提示。 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_curve_default_title"
                            android:textSize="14sp" />

                        <Spinner
                            android:id="@+id/spinner_realtime_curve_default"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="112dp"
                            android:dropDownWidth="190dp"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>

                    <!-- 第三项（2026-11-10）：最大压差记录阈值（mV）。
                         与上面两项同样的「一行搞定」风格：左边文字，右边数字输入框。
                         ⚠️ 不写任何提示文案；留空/非法值在失焦或退出页面时回填 50。 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_diff_threshold_title"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_diff_threshold"
                            android:layout_width="88dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:minWidth="88dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 第四项（2026-11-10）：极速记录阈值（Km/h），风格与第三项一致 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_top_speed_threshold_title"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_top_speed_threshold"
                            android:layout_width="88dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:minWidth="88dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 第五项（2026-11-10）：电流记录阈值（A），默认 50 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_current_threshold_title"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_current_threshold"
                            android:layout_width="88dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:minWidth="88dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 第六项（2026-11-10）：功率记录阈值（W），默认 1000 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_power_threshold_title"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_power_threshold"
                            android:layout_width="88dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:minWidth="88dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 第七项（2026-11-10）：实时卡片胎压显示。
                         三个选项：始终显示 / 始终不显示 / 胎压异常时显示。
                         与前两项一样：一行文字 + 右侧下拉，无任何提示。 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_realtime_tpms_display_title"
                            android:textSize="14sp" />

                        <Spinner
                            android:id="@+id/spinner_realtime_tpms_display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="128dp"
                            android:dropDownWidth="190dp"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
