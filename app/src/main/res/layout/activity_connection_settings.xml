<?xml version="1.0" encoding="utf-8"?>
<!--
  ⭐ 独立的「连接设置」页（用户 2026-11-09 要求）：
  从首页连接状态卡的齿轮进来，只放连接相关设置，**不与胎压设置页共享**。

  七项（每项一行：左边文字、右边控件，不写任何说明文案）：
  1. 连接BMS后跳转 —— 不跳转 / 实时·页面 / 数据·页面 / 导航·页面
  2. 实时界面曲线显示 —— 默认显示 / 默认不显示
  3~6. 四项记录阈值（数字输入）：压差 mV / 极速 Km-h / 电流 A / 功率 W
  7. 实时卡片胎压显示 —— 始终显示 / 始终不显示 / 胎压异常时显示

  ⭐ 2026-11-11 对齐口径（用户：「备选和弹出来的菜单，包括下面填的数值，都要居中」）：
  - 左侧标题一律**左对齐**；
  - 右侧控件里的文字一律**居中**，且**共用同一条中轴**：
    下拉框选中项、下拉弹出菜单每一项、数字输入框里的数值。
  - 所以 7 个控件**宽度必须完全一致**（都是 152dp）——宽度不同就没有共同中轴，
    文字各自在自己框里居中，看起来仍然是歪的（实测过：132dp 时下拉框文字中心
    比输入框数字中心偏左 73px ≈ 24dp）。

  ⚠️ 为什么下拉框要包一层 FrameLayout 自己画箭头：
     系统 Spinner 的背景 `abc_spinner_mtrl_am_alpha` 在右侧给箭头留了约 **49dp**
     空白，文字只能在剩下的约 83dp 里居中 → 文字中心天然偏左，
     而且「胎压异常时显示」会被挤成两行。
     改成：Spinner 用 `background=@null` + 左右**等量** padding(20dp)，
     文字中心就回到控件正中；箭头用一个 ▾ TextView 叠在右侧 padding 区里
     （不可点击、不吃触摸，点击照样落到 Spinner 上）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ⭐ 本页标题固定为「设置」（用户 2026-11-11：「弹出来的那个左侧 连接设置 改为设置」）。
         ⚠️ 用本页专属的 `connection_settings_title`，**不共用**胎压设置页的
            `title_settings` —— 两页各管各的文案，改一个不会牵连另一个。
         ⚠️ 也不要直接用 `connection_settings`（「连接设置」）：那个仍留给
            首页齿轮的 contentDescription 和本 Activity 在 Manifest 里的 label，
            齿轮按钮叫「连接设置」才说明得清它进的是哪个设置。 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/connection_settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ⚠️ 页面 padding 8dp（原 12dp）+ 卡片 contentPadding 12dp（原 16dp）：
             省出来的 16dp 全部给控件列，否则「压差记录阈值（mV）」这种长标题
             会被挤到换行。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:contentPadding="12dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ========== 第一项：连接BMS后跳转 ========== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_connect_jump_title"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="152dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                            <Spinner
                                android:id="@+id/spinner_connect_jump_tab"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:dropDownWidth="190dp"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:spinnerMode="dropdown" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="4dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"
                                android:text="▾"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />
                            </FrameLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="?attr/colorControlNormal" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ========== 第二项：实时界面曲线显示 ========== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_curve_default_title"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="152dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                            <Spinner
                                android:id="@+id/spinner_realtime_curve_default"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:dropDownWidth="190dp"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:spinnerMode="dropdown" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="4dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"
                                android:text="▾"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />
                            </FrameLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="?attr/colorControlNormal" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ========== 第三项：压差记录阈值（mV） ========== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_diff_threshold_title"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_diff_threshold"
                            android:layout_width="152dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- ========== 第四项：速度记录阈值（Km/h） ========== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_top_speed_threshold_title"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_top_speed_threshold"
                            android:layout_width="152dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- ========== 第五项：电流记录阈值（A） ========== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_current_threshold_title"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_current_threshold"
                            android:layout_width="152dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- ========== 第六项：功率记录阈值（W） ========== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_power_threshold_title"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_power_threshold"
                            android:layout_width="152dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- ========== 第七项：实时卡片胎压显示 ========== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setting_realtime_tpms_display_title"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="152dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                            <Spinner
                                android:id="@+id/spinner_realtime_tpms_display"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:dropDownWidth="190dp"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:spinnerMode="dropdown" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="4dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"
                                android:text="▾"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />
                            </FrameLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="?attr/colorControlNormal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
