<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 汇总：极值与压差判定 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_summary_verdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/state_connected"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="压差正常" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/MetricContainer">

                    <TextView
                        style="@style/MetricLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_cell_max" />

                    <TextView
                        android:id="@+id/tv_summary_max"
                        style="@style/MetricValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="4.180V" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/MetricContainer">

                    <TextView
                        style="@style/MetricLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_cell_min" />

                    <TextView
                        android:id="@+id/tv_summary_min"
                        style="@style/MetricValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="4.100V" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/MetricContainer">

                    <TextView
                        style="@style/MetricLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_cell_diff" />

                    <TextView
                        android:id="@+id/tv_summary_diff"
                        style="@style/MetricValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/state_connected"
                        tools:text="80mV" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/MetricContainer">

                    <TextView
                        style="@style/MetricLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_cell_count" />

                    <TextView
                        android:id="@+id/tv_summary_count"
                        style="@style/MetricValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="13串" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/cell_diff_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_cell_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        tools:itemCount="6"
        tools:listitem="@layout/item_cell_detail" />
</LinearLayout>