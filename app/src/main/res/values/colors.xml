    <!-- 异常标红 -->
    <color name="abnormal">#C62828</color>

    <!-- 曲线 -->
    <color name="chart_soc">#1565C0</color>
    <color name="chart_voltage">#2E7D32</color>
    <color name="chart_current">#EF6C00</color>
    <color name="chart_grid">#E0E0E0</color>

    <color name="background">#F5F6F8</color>
    <color name="surface">#FFFFFF</color>

    <!-- 诊断面板「隐形表格」：格子线与表头底色。
         刻意做得很淡，表格是给人看数据的，不该抢内容的视觉权重 -->
