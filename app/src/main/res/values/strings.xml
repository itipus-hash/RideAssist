    <!-- ⭐ 第一行：预估里程（独占一行，突出核心总量） -->
    <string name="ride_distance_label">本次里程预估</string>
    <string name="ride_estimated_range_label">预计可行驶里程</string>

    <!-- ⭐ 第二行（行程口径，含停车的时间轴）：
         开始时间 / 行程用时 / 行程均速
         ⭐ 按**同一口径放在同一行**分组（用户要求）：
         「行程」是时间轴（含等红灯），「骑行」是运动状态（剔除停车），
         同一口径放在同一行，横向对比时语义不会串。 -->
    <string name="ride_started_at_label">开始时间</string>
    <string name="ride_trip_duration_label">行程用时</string>
    <string name="ride_trip_avg_speed_label">行程均速</string>

    <!-- ⭐ 第三行（骑行口径，剔除停车）：
         百公里能耗 / 骑行用时 / 骑行均速
         单位一律放数值**下方**（MetricUnit 样式），不拼进标签也不拼进数值后面。 -->
    <!-- 百公里能耗 = 总耗能(Wh) ÷ 总里程(km) × 100。
         比「百公里加速到 100km/h 耗时」更贴近日常换算：直接乘单次里程即得补能成本。 -->
    <string name="ride_energy_per_100_label">百公里能耗</string>
    <string name="ride_duration_label">骑行用时</string>
    <string name="ride_avg_speed_label">骑行均速</string>

    <!-- 单位（显示在数值下方，视觉层级低于标签/数值）
     ⚠️ km/h 复用上面已有的 unit_kmh，不要重复定义（资源 merger 会报错）。
     ⚠️ 单位**只在数值有效时才显示**（见 RideDataFragment.renderSummary）——
     数值是占位符时，独留一条「km/h」很奇怪（像是有值却读不出来）。 -->
    <string name="unit_kwh">Kwh</string>
    <string name="unit_km">km</string>

    <!-- 值尚未产生时的占位。用短横线而不是四遍「尚未开始」：
         骑行前四个字段全是同一句话，视觉噪音大且占了四倍空间。
         空状态提示只在页面下方说一次。
         ⚠️ 注释里不能出现连续的英文双连字符，资源 merger 会报 parse 错误。 -->
    <string name="ride_placeholder">--</string>
    <!-- 时长格式：中文单位直读，如「1 时 05 分 30 秒」「12 分 54 秒」
     ⚠️ 用「时分秒」文字而非 HH:mm:ss —— 开始时间那一栏已经用冒号表示时刻，
     同页再出现冒号会造成「这个冒号是时间点还是时长」的歧义。
     ⚠️ 秒/分一律不补零（「5 分 3 秒」而非「05 分 03 秒」）：
     中文语境下补零反而看着像时间戳。 -->
    <string name="ride_duration_hms">%1$d 时 %2$d 分 %3$d 秒</string>
    <string name="ride_duration_ms">%1$d 分 %2$d 秒</string>

